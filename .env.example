# ---------------------------------------------------------------------------
# ASCEND — Agency Operating System
# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored and must stay that
# way: several values below are live credentials.
#
# THE ONE RULE THAT MATTERS. A `NEXT_PUBLIC_` prefix compiles the value into
# the JavaScript every visitor downloads. Exactly four variables belong there:
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
# NEXT_PUBLIC_SITE_URL and NEXT_PUBLIC_SENTRY_DSN. Nothing else, ever.
#
# `npm run preflight` refuses to build if a secret carries that prefix, and
# separately detects a service_role key pasted into the anon slot by reading
# the JWT's `role` claim.

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# The anon key is safe in the browser — Row Level Security is what protects the
# data. The service role key is NOT: it bypasses RLS entirely. Keep it out of
# any NEXT_PUBLIC_ variable and never reference it from a client component.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Written to by the Stripe webhook, the calendar sync and the
# outreach engine — the three paths that must work without a user session.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Lead ingestion (optional)
# ---------------------------------------------------------------------------
# This repository contains no scraper. Leads arrive from an external pipeline
# over POST /api/crm/sync-leads, authenticated with the shared secret below.
# See docs/lead-ingestion.md for the payload contract.
#
# Leave blank to keep that route disabled — it refuses every request until this
# is set, rather than accepting unauthenticated writes.
#   openssl rand -hex 32
LEAD_SYNC_SECRET=

# ---------------------------------------------------------------------------
# Google Calendar (optional)
# ---------------------------------------------------------------------------
# Leave blank and the CRM keeps appointments to itself — the calendar page says
# so rather than looking broken. Set them and each user can connect their own
# Google account from /calendar.
#
# Create an OAuth client (type: Web application) at console.cloud.google.com,
# enable the Google Calendar API, and add the callback below as an authorised
# redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Derived from the request origin when blank, which is what preview
# deployments need; set it when the Google console has one fixed URI.
GOOGLE_REDIRECT_URI=

# Encrypts OAuth tokens before they are written to the database, so a Postgres
# backup on its own is not a set of live Google credentials. Required to
# connect a calendar at all.
#   openssl rand -base64 32
# Changing this makes every stored token unreadable and every calendar has to
# be reconnected.
CALENDAR_TOKEN_KEY=

# Shared secret for POST /api/crm/calendar/sync, so a scheduler can sync every
# connected account. Blank leaves scheduled syncing disabled; the in-app
# "Sync now" button works either way.
#   openssl rand -hex 32
CALENDAR_SYNC_SECRET=

# Enables Google push notifications, so changes made in Google appear here
# promptly instead of at the next poll. Optional: the sync converges without
# it.
#   openssl rand -hex 32
CALENDAR_WEBHOOK_SECRET=
# The public URL Google should call. Must be reachable from the internet and
# HTTPS, so localhost cannot use this.
#   https://crm.youragency.com/api/crm/calendar/webhook
CALENDAR_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Stripe (optional)
# ---------------------------------------------------------------------------
# Leave blank and the CRM records no billing — the payments page says so rather
# than looking broken. Set them and invoices and retainers can be raised from a
# client's page.
#
# Use a test key (sk_test_…) until you mean it. The payments page shows which
# mode is in use.
STRIPE_SECRET_KEY=

# From the Stripe dashboard → Developers → Webhooks, after adding an endpoint
# pointing at https://<your-host>/api/crm/stripe/webhook
#
# Without this NOTHING EVER MOVES TO PAID. The frontend cannot set payment
# status — the database has no write policy on `payments` for any role — so the
# webhook is the only thing that can, by design.
#
# Subscribe the endpoint to at least:
#   invoice.created, invoice.finalized, invoice.sent, invoice.paid,
#   invoice.payment_failed, invoice.marked_uncollectible, invoice.voided,
#   customer.subscription.created, customer.subscription.updated,
#   customer.subscription.deleted, charge.refunded
STRIPE_WEBHOOK_SECRET=

# Currency invoices are raised in, lower-case. Defaults to gbp.
STRIPE_CURRENCY=gbp

# ---------------------------------------------------------------------------
# Outreach (optional)
# ---------------------------------------------------------------------------
# THIS IS THE ONLY PART OF THE CRM THAT CONTACTS STRANGERS.
#
# Setting these keys does not start anything. Sending is governed by
# `outreach_settings.sending_enabled` in the database, which defaults to FALSE
# and can only be turned on by an owner or admin, on the /outreach page.
#
# Resend, for email. The webhook secret is required for reply detection,
# bounces and spam complaints — without it a hard-bounced address is never
# suppressed and the sending domain suffers for it.
#   Endpoint: https://<your-host>/api/crm/outreach/email
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Twilio, for SMS. Inbound replies (including "STOP") arrive at
#   https://<your-host>/api/crm/outreach/sms
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio signs the URL configured in its console. State it here rather than
# trusting a forwarded header, which an attacker controls.
TWILIO_WEBHOOK_URL=

# Shared secret for POST /api/crm/outreach/run, so a scheduler can drive the
# engine. Blank leaves scheduled sending disabled; an admin can still run it by
# hand from /outreach.
#   openssl rand -hex 32
OUTREACH_RUN_SECRET=

# Public base URL for unsubscribe links. These have to keep working for months
# after a message was sent, so set it explicitly rather than relying on
# whichever deployment happened to send.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Error monitoring (optional)
# ---------------------------------------------------------------------------
# Without a DSN the SDK is inert and errors go to the runtime log as structured
# JSON lines tagged [crm]. Reporting is wired into the unattended paths — the
# cron endpoints and the webhooks — because those have nobody watching them.
#
# Session replay and performance tracing are off, and sendDefaultPii is false:
# every screen in this app is full of other people's business data.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Only needed to upload source maps. Without the token the upload step is
# skipped rather than warned about on every build.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
